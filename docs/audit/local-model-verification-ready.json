          "source_sha256": "7ea0a59f7d076846a4f30540dc9572b844e1df61d2a6e33cc994cf3647d96038",
          "source_title": "省水产技术推广总站关于印发2024年湖北省夏季高温水产养殖生产管理措施的通知",
          "status": "reference_not_site_fact",
          "steps": [
            {
              "action": "先核实养殖类别，复测溶氧与不同水层的水温，观察浮头情况。",
              "conditions": [
                "确认是池塘养殖"
              ],
              "limitations": [
                "本条未提供本塘实测值"
              ],
              "priority": 1
            },
            {
              "action": "由现场人员结合天气、分层及设备状态制定增氧和水质调控措施。",
              "conditions": [
                "观测有效",
                "设备经安全检查"
              ],
              "limitations": [
                "未评估容量时不指定设备数量、运行时长或新增采购"
              ],
              "priority": 2
            }
          ],
          "summary": "该指导强调高温期水环境监测及增氧管理，同时区分鱼塘与虾蟹塘。搅动水体可能改变温度分层；品种、天气和分层情况不清楚时，不能直接给出统一开机时段。",
          "title": "湖北夏季高温池塘管理：溶氧与水温核查",
