          "source_title": "Fish culture in undrainable ponds — Principles of freshwater fish culture",
          "status": "reference_not_site_fact",
          "steps": [
            {
              "action": "保留采样时刻、水温和测点，比较具有可比条件的有效观测。",
              "conditions": [
                "传感器质量合格"
              ],
              "limitations": [
