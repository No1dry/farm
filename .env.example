# Load precedence: runtime/backend-config.json < project .env < process environment.
# Copy only needed settings to .env. Blank model values override installed local model settings.
FARM_DB_PATH=runtime/farm.sqlite3
FARM_AUTH_MODE=local
# local: localhost browser operator session; admin requires CLI bearer token.
# token: no browser session; operator/admin bearer only. readonly: writes disabled.
# Credentials are generated in ignored runtime/backend-config.json; never put them in frontend code.
# FARM_ADMIN_TOKEN=replace-with-private-random-token
# FARM_OPERATOR_TOKEN=replace-with-private-random-token

# scripts/configure_local_model.py writes the installed local provider configuration.
# To choose another OpenAI-compatible provider, uncomment and configure server-side:
# FARM_MODEL_BASE_URL=http://127.0.0.1:8081/v1
# FARM_MODEL_NAME=qwen3-4b-local
# FARM_MODEL_API_KEY=server-private-value
# FARM_MODEL_TIMEOUT_SECONDS=120
# FARM_MODEL_MAX_TOKENS=1800
# FARM_MODEL_CONSTRAINED_JSON=true
# FARM_CONFIG_FILE is an optional process-environment path to the private JSON config.
